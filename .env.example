# Flask Configuration
SECRET_KEY=secret123

# Database Configuration (Optional - Defaults to SQLite database.db if not provided or PostgreSQL unavailable)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upiscamdb
DB_USER=postgres
DB_PASSWORD=your_password

# Email Configuration - Option 1: Standard SMTP (Recommended for Gmail, Outlook, etc.)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# Email Configuration - Option 2: Resend API Key
RESEND_API_KEY=re_123456789

