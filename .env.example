# ==============================================================================
# UPI Scam Analyzer Environment Configuration
# NOTE: SECRET_KEY, SENDER_EMAIL, SENDER_PASSWORD, ADMIN_EMAIL, and DATABASE_URL
# are strictly REQUIRED in production (APP_ENV=production or RENDER set).
# The application will fail fast at startup if any are missing.
# ==============================================================================

# Flask Session & Token Security (REQUIRED in all environments - No fallback)
SECRET_KEY=your_secure_random_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Admin Account Configuration (REQUIRED in production - No fallback)
ADMIN_EMAIL=admin@example.com

# Database Configuration (REQUIRED in production - Defaults to local SQLite database.db in development)
# DATABASE_URL=postgresql://user:password@localhost:5432/upiscamdb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upiscamdb
DB_USER=postgres
DB_PASSWORD=your_db_password

# Email Configuration (REQUIRED in production for OTP delivery - No fallback)
# Option 1: Standard SMTP (Recommended for Gmail, Outlook, etc.)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_smtp_app_password

# Option 2: Resend / Brevo API Keys (Optional alternatives to SMTP)
# RESEND_API_KEY=re_123456789
# BREVO_API_KEY=xkeysib-123456789

