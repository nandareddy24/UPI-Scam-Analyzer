{
  "manifest_version": 3,
  "name": "ScamShield - Real-Time Cyber Protection",
  "version": "1.0.0",
  "description": "Continuous real-time protection against phishing, fraudulent websites, and malicious UPI portals.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScamShield Security Status"
  }
}
