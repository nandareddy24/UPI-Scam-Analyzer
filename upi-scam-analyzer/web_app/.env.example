# Copy this file to ".env" (same folder) and fill in YOUR values.
# NEVER commit the real ".env" or paste real keys into a chat.
# Get these from: Firebase console -> Project settings -> General ->
# "Your apps" -> Web app (</> icon). Add a web app there if you don't have one yet.

VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Where the Node OTP server (backend-otp-server/) is running
VITE_OTP_API_BASE=http://localhost:4000
