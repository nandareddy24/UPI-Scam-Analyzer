# Copy this file to ".env" (same folder) and fill in YOUR OWN values.
# NEVER commit the real ".env" file to git or paste real credentials into a chat.

# Port the OTP server runs on
PORT=4000

# Gmail address you are sending OTP emails FROM
EMAIL_USER=your_gmail_address@gmail.com

# A Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account)
EMAIL_PASS=your_16_character_app_password

# How long an OTP stays valid, in minutes
OTP_EXPIRY_MINUTES=5

# Comma separated list of origins allowed to call this API
# e.g. http://localhost:PORT for flutter web debug, and your deployed web URL
CORS_ORIGIN=*
