{
  "manifest_version": 3,
  "name": "Scam Shield AI - UPI & Cyber Fraud Scanner",
  "version": "1.0.0",
  "description": "Instant real-time threat detection for UPI VPAs, Phishing URLs, and SMS messages.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ]
}
